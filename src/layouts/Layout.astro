---
import { basics } from "@cv";

interface Props {
  title: string;
}

const { title } = Astro.props;
const { image, summary } = basics;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href={image} />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg-color: #fcfcfc;
    --text-color: #666666;
    --title-color: #111;
    --light-color: #666;
    --muted-color: #bbb;
    --icon-color: #777;
    --border-color: rgb(200 200 200 / 50%);
    --hover-bg: #eee;
    --hover-border: #ddd;
    --chip-bg: #eee;
    --chip-color: #555;
    --chip-hover-bg: #ccc;
    --chip-hover-color: #000;
    --surface-color: #fdfdfd;
    --kbd-bg: #eee;
    --footer-text: #aaa;
    --skill-bg: rgb(0 0 0 / 10%);
    --skill-hover-bg: rgb(0 0 0 / 30%);
    --skill-color: #555;
    --skill-hover-color: #000;
    --skill-filter: invert(50%);
    --card-shadow: 0 1px 1px #f2f2f2;
    --tooltip-bg: #888;
    --tooltip-color: #fff;
    --figure-bg: rgb(0 0 0 / 20%);
  }

  html[data-theme="light"] {
    color-scheme: light;
  }

  html[data-theme="dark"] {
    color-scheme: dark;
    --bg-color: #161616;
    --text-color: #c4c4c4;
    --title-color: #f4f4f4;
    --light-color: #a3a3a3;
    --muted-color: #737373;
    --icon-color: #d4d4d4;
    --border-color: rgb(255 255 255 / 14%);
    --hover-bg: #2a2a2a;
    --hover-border: #404040;
    --chip-bg: #2a2a2a;
    --chip-color: #d4d4d4;
    --chip-hover-bg: #3f3f3f;
    --chip-hover-color: #fff;
    --surface-color: #1c1c1c;
    --kbd-bg: #2a2a2a;
    --footer-text: #737373;
    --skill-bg: rgb(255 255 255 / 10%);
    --skill-hover-bg: rgb(255 255 255 / 18%);
    --skill-color: #e5e5e5;
    --skill-hover-color: #fff;
    --skill-filter: none;
    --card-shadow: 0 1px 1px rgb(0 0 0 / 40%);
    --tooltip-bg: #404040;
    --tooltip-color: #f5f5f5;
    --figure-bg: rgb(255 255 255 / 8%);
  }

  html[data-theme="dark"] ninja-keys {
    --ninja-overflow-background: rgba(0, 0, 0, 0.55);
    --ninja-text-color: #e5e5e5;
    --ninja-secondary-background-color: #2a2a2a;
    --ninja-secondary-text-color: #a3a3a3;
    --ninja-selected-background: #333;
    --ninja-modal-background: #1f1f1f;
    --ninja-footer-background: rgba(0, 0, 0, 0.3);
    --ninja-placeholder-color: #888;
    --ninja-group-text-color: #888;
    --ninja-accent-color: #a78bfa;
  }

  html {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      "Courier New",
      Courier,
      monospace;
    background: var(--bg-color);
    letter-spacing: -0.025rem;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
    background-color: var(--bg-color);
  }

  body {
    color: var(--text-color);
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  a:hover {
    text-decoration: underline;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
    color: var(--title-color);
  }

  p {
    color: var(--text-color);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  @media print {
    .no-print {
      display: none !important;
    }
  }

  .print {
    display: none !important;
  }

  @media print {
    .print {
      display: block !important;
    }

    html,
    html[data-theme="dark"] {
      color-scheme: light;
      --bg-color: #fcfcfc;
      --text-color: #666666;
      --title-color: #111;
      --light-color: #666;
      --muted-color: #bbb;
      --icon-color: #777;
      --border-color: rgb(200 200 200 / 50%);
      --hover-bg: #eee;
      --hover-border: #ddd;
      --chip-bg: #eee;
      --chip-color: #555;
      --surface-color: #fff;
      --skill-bg: rgb(248, 248, 248);
      --skill-color: #666;
      --skill-filter: none;
    }

    body {
      background-color: #fff;
    }
  }
</style>
